# Copy to .env.local and fill in. Never commit real keys.

# Anthropic API key (workspace-scoped), used server-side only: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Voyage AI key for embeddings: https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Supabase project URL and secret key (Project Settings → API Keys). The secret
# key bypasses row level security: server and ingest only, never in the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# "retrieval" (default) or "baseline" (all content in the prompt, no database).
RETRIEVAL_MODE=retrieval

# Rate limiting needs no variables: it is a Vercel Firewall rule (see the README).
